		-
			message: '#^Offset ''transport_sharing'' on array\{transport_sharing\: true\} in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.offset
			count: 1
			path: src/Handler/StreamHandler.php

		-
			message: '#^Call to function array_key_exists\(\) with 0 and array\{callable\(callable&THandler\)\: \(callable&THandler\), string\|null\} will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/HandlerStack.php

		-
			message: '#^Call to function is_array\(\) with array\{callable\(callable&THandler\)\: \(callable&THandler\), string\|null\} will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/HandlerStack.php

		-
			message: '#^Call to function is_callable\(\) with callable\(\)\: mixed&THandler will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 2
			path: src/HandlerStack.php

		-
			message: '#^Call to function is_callable\(\) with callable\(callable&THandler\)\: \(callable&THandler\) will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 2
			path: src/HandlerStack.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 1
			path: src/HandlerStack.php

		-
			message: '#^Result of \|\| is always false\.$#'
			identifier: booleanOr.alwaysFalse
			count: 2
			path: src/HandlerStack.php

		-
			message: '#^Instanceof between ArrayAccess\<int, array\<string, mixed\>\> and ArrayAccess will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: src/Middleware.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 1
			path: src/Middleware.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 1
			path: src/Utils.php

		-
			message: '#^Method GuzzleHttp\\Utils\:\:jsonDecode\(\) should return array\|bool\|float\|int\|object\|string\|null but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/Utils.php

		-
			message: '#^Parameter \#1 \$options of class GuzzleHttp\\Handler\\CurlHandler constructor expects array\{handle_factory\?\: GuzzleHttp\\Handler\\CurlFactoryInterface\|null, transport_sharing\?\: mixed\}, array\<string, mixed\> given\.$#'
			identifier: argument.type
			count: 2
			path: src/Utils.php

		-
			message: '#^Parameter \#3 \$depth of function json_encode expects int\<1, max\>, int given\.$#'
			identifier: argument.type
			count: 1
			path: src/Utils.php

		-
			message: '#^Strict comparison using \!\=\= between string and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Utils.php
